{
    "name": "comfino/prestashop",
    "type": "prestashop-module",
    "description": "PrestaShop payment module for Comfino deferred payments gateway.",
    "homepage": "https://github.com/comfino/PrestaShop",
    "license": "OSL-3.0",
    "authors": [
        {
            "name": "Artur Kozubski",
            "email": "akozubski@comperia.pl",
            "homepage": "https://comfino.pl/plugins/PrestaShop/en"
        }
    ],
    "config": {
        "preferred-install": "dist",
        "platform-check": false,
        "platform": {
            "php": "7.1.3"
        },
        "optimize-autoloader": true,
        "prepend-autoloader": false,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "autoload": {
        "psr-4": {
            "Comfino\\": "src/"
        },
        "classmap": []
    },
    "autoload-dev": {
        "psr-4": {
            "Comfino\\Tests\\": "tests/"
        },
        "classmap": []
    },
    "require": {
        "php": ">=7.1",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-zlib": "*",
        "comfino/shop-plugins-shared": "dev-master",
        "cache/adapter-common": "~1.2.0",
        "cache/hierarchical-cache": "~1.1.0",
        "league/flysystem": "~1.0.70",
        "monolog/monolog": "^1.27",
        "psr/log": "^1.1",
        "symfony/deprecation-contracts": "<3.0",
        "symfony/options-resolver": "~4.4.0",
        "symfony/polyfill-ctype": "<1.31",
        "symfony/polyfill-php73": "^1.0 <1.31",
        "symfony/polyfill-php80": "^1.0 <1.31",
        "symfony/yaml": "~4.4.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.6",
        "php-http/mock-client": "^1.6",
        "phpdocumentor/reflection-common": "~2.1.0",
        "phpdocumentor/reflection-docblock": "~4.3.4",
        "phpdocumentor/type-resolver": "~1.0.1",
        "phpspec/prophecy-phpunit": "^1.1",
        "phpunit/phpunit": "^5.7",
        "prestashop/php-dev-tools": "^4.3",
        "webmozart/assert": "<1.10"
    },
    "repositories": [
        {
            "type": "artifact",
            "url": "packages/sunrise"
        },
        {
            "type": "vcs",
            "url": "git@github.com:comfino/shop-plugins-shared.git",
            "no-api": true
        }
    ]
}
